# ==========================================
# GD Arena Environment Variables Template
# ==========================================

# ------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Server-Only)
# Set these on your Render Web Service
# ------------------------------------------
NODE_ENV=production
PORT=8787
ALLOWED_ORIGIN=https://your-frontend.onrender.com

# LLM API Keys (Keep server-only; NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Build-time)
# Set these on your Render Static Site (or leave blank if single-service deployment)
# ------------------------------------------
# VITE_API_BASE_URL=https://your-backend.onrender.com
# VITE_WS_URL=wss://your-backend.onrender.com
